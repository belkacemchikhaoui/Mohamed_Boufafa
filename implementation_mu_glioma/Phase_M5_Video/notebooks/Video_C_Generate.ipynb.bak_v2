   "source": [
    "# Summary: key frames comparison per patient (Linear vs DDPM)\n",
    "n_show=min(3,len(selected_pids))\n",
    "fig,axes=plt.subplots(n_show*2,5,figsize=(20,8*n_show))\n",
    "fig.suptitle('Visual Comparison: Linear Interpolation vs. DDPM Refined',fontsize=16,fontweight='bold')\n",
    "\n",
    "for j,t_label in enumerate(['t=0.0','t=0.25','t=0.50','t=0.75','t=1.0']):\n",
    "    axes[0,j].set_title(t_label,fontsize=12,fontweight='bold')\n",
    "\n",
    "for row_idx,pid in enumerate(selected_pids[:n_show]):\n",
    "    pair=patient_pairs[pid][0]\n",
    "    ss=pair['seg_start'];se=pair['seg_end'];t1c=pair['t1c_start']\n",
    "    \n",
    "    ax_row_linear = row_idx * 2\n",
    "    ax_row_ddpm = row_idx * 2 + 1\n",
    "    \n",
    "    for j,tv in enumerate([0.0,0.25,0.50,0.75,1.0]):\n",
    "        # Calculate Linear Frame\n",
    "        if tv==0:seg_lin=morpho_cleanup(ss)\n",
    "        elif tv==1.0:seg_lin=morpho_cleanup(se)\n",
    "        else:seg_lin=generate_linear_frame(ss,se,tv)\n",
    "        \n",
    "        # Calculate DDPM Frame\n",
    "        if tv==0:seg_ddpm=morpho_cleanup(ss)\n",
    "        elif tv==1.0:seg_ddpm=morpho_cleanup(se)\n",
    "        else:seg_ddpm=generate_frame(model,ss,se,tv)\n",
    "        \n",
    "        # Render Linear frame\n",
    "        ax_lin = axes[ax_row_linear,j]\n",
    "        ax_lin.imshow(overlay_all(seg_lin,t1c),origin='lower',interpolation='bilinear')\n",
    "        ax_lin.axis('off')\n",
    "        if j==0:\n",
    "            ax_lin.set_ylabel(f'{pid}\\nLinear',fontsize=10,fontweight='bold',rotation=0,ha='right',va='center')\n",
    "            \n",
    "        # Render DDPM frame\n",
    "        ax_ddpm = axes[ax_row_ddpm,j]\n",
    "        ax_ddpm.imshow(overlay_all(seg_ddpm,t1c),origin='lower',interpolation='bilinear')\n",
    "        ax_ddpm.axis('off')\n",
    "        if j==0:\n",
    "            ax_ddpm.set_ylabel(f'{pid}\\nDDPM',fontsize=10,fontweight='bold',rotation=0,ha='right',va='center')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(str(OUT/'summary_keyframes.png'),dpi=150,bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Saved comparison summary_keyframes.png')\n"
   ]
  },
