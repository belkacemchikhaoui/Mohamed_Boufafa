    "# Load triplets and group by patient\n",
    "tp=None\n",
    "for p in Path('/kaggle/input').rglob('mu_glioma_triplets.npz'):tp=p;break\n",
    "if tp is None:raise RuntimeError('triplets not found!')\n",
    "d=np.load(tp,allow_pickle=True)\n",
    "seg_s,seg_e,seg_g=d['seg_start'],d['seg_end'],d['seg_gt']\n",
    "t1c_s,t_interp=d['t1c_start'],d['t_interp']\n",
    "pids=d['pids'];types=d['types']\n",
    "print(f'Loaded {len(seg_s)} triplets, {len(np.unique(pids))} patients')\n",
    "\n",
    "# Group consecutive scan pairs per patient (identity pairs give us the real scans)\n",
    "# identity_0: seg_start=real_t0, seg_end=real_t1, t=0 -> gt=real_t0\n",
    "# identity_1: seg_start=real_t0, seg_end=real_t1, t=1 -> gt=real_t1\n",
    "patient_pairs=defaultdict(list)\n",
    "for i in range(len(seg_s)):\n",
    "    if types[i]=='identity_0':\n",
    "        patient_pairs[pids[i]].append({\n",
    "            'seg_start':seg_s[i],'seg_end':seg_e[i],\n",
    "            't1c_start':t1c_s[i]\n",
    "        })\n",
    "\n",
    "print(f'Patients with pairs: {len(patient_pairs)}')\n",
    "for pid in sorted(patient_pairs.keys())[:5]:\n",
    "    print(f'  {pid}: {len(patient_pairs[pid])} consecutive pairs')\n"
   ]
  },
