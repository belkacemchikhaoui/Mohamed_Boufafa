   "source": [
    "# ============================================================\n",
    "# HELPER FUNCTIONS (seg_to_soft, morpho_cleanup, predict_x0,\n",
    "# enforce_containment, overlay_all, generate_linear_frame, etc.)\n",
    "# ============================================================\n",
    "from scipy import ndimage\n",
    "\n",
    "def seg_to_soft(seg, C=5):\n",
    "    \"\"\"One-hot encode segmentation labels into soft channels scaled to [-0.95, +0.95].\"\"\"\n",
    "    oh = np.zeros((C, seg.shape[0], seg.shape[1]), dtype=np.float32)\n",
    "    for c in range(C):\n",
    "        oh[c] = (seg == c).astype(np.float32)\n",
    "    return oh * 1.9 - 0.95\n",
    "\n",
    "def predict_x0(xt, t, noise_pred):\n",
    "    \"\"\"DDPM single-step x0 prediction from noisy sample.\"\"\"\n",
    "    x0 = (xt - s1mac[t][:,None,None,None]*noise_pred) / sac[t][:,None,None,None].clamp(min=1e-4)\n",
    "    return x0.clamp(-2, 2)\n",
    "\n",
    "def enforce_containment(seg):\n",
    "    \"\"\"BraTS hierarchy: ET ⊆ TC ⊆ WT. Fix any violations.\"\"\"\n",
    "    out = seg.clone()\n",
    "    tc = (out == 1) | (out == 4)\n",
    "    et = out == 4\n",
    "    et_outside_tc = et & ~tc\n",
    "    out[et_outside_tc] = 1\n",
    "    tc = (out == 1) | (out == 4)\n",
    "    wt = out > 0\n",
    "    tc_outside_wt = tc & ~wt\n",
    "    out[tc_outside_wt] = 2\n",
    "    return out\n",
    "\n",
    "def morpho_cleanup(seg, min_size=30):\n",
    "    \"\"\"Remove small isolated pixel islands per class using connected components.\"\"\"\n",
    "    out = seg.copy().astype(np.int64)\n",
    "    for label in [1, 2, 4]:\n",
    "        mask = (seg == label)\n",
    "        if not mask.any():\n",
    "            continue\n",
    "        labeled, n = ndimage.label(mask)\n",
    "        if n == 0:\n",
    "            continue\n",
    "        sizes = ndimage.sum(mask, labeled, range(1, n + 1))\n",
    "        for comp_idx in range(n):\n",
    "            if sizes[comp_idx] < min_size:\n",
    "                out[labeled == (comp_idx + 1)] = 0\n",
    "    return out\n",
    "\n",
    "def dice_sc(p, g):\n",
    "    \"\"\"Compute WT/TC/ET Dice scores.\"\"\"\n",
    "    r = {}\n",
    "    for n, pm, gm in [('WT', p>0, g>0),\n",
    "                      ('TC', (p==1)|(p==4), (g==1)|(g==4)),\n",
    "                      ('ET', p==4, g==4)]:\n",
    "        inter = (pm & gm).sum().float()\n",
    "        denom = pm.sum().float() + gm.sum().float() + 1e-8\n",
    "        r[n] = (2 * inter / denom).item()\n",
    "    return r\n",
    "\n",
    "# ── BraTS subregion helpers ──────────────────────────────────────────────\n",
    "def get_wt(seg): return seg > 0\n",
    "def get_tc(seg): return (seg == 1) | (seg == 4)\n",
    "def get_et(seg): return seg == 4\n",
    "\n",
    "def _norm_t1c(t1c):\n",
    "    t = t1c - t1c.min()\n",
    "    mx = t.max()\n",
    "    return t / mx if mx > 0 else t\n",
    "\n",
    "def overlay_all(seg, t1c, alpha=0.55):\n",
    "    \"\"\"Overlay WT/TC/ET regions on T1c (green/blue/red).\"\"\"\n",
    "    tn = _norm_t1c(t1c)\n",
    "    rgb = np.stack([tn, tn, tn], axis=-1)\n",
    "    color_map = {2: [0.2,0.8,0.3], 1: [0.2,0.4,1.0], 4: [1.0,0.2,0.2]}\n",
    "    for label, color in color_map.items():\n",
    "        mask = (seg == label)\n",
    "        if mask.any():\n",
    "            for c in range(3):\n",
    "                rgb[..., c] = np.where(mask, (1-alpha)*tn + alpha*color[c], rgb[..., c])\n",
    "    return np.clip(rgb, 0, 1)\n",
    "\n",
    "def overlay_region(mask, t1c, color, alpha=0.6):\n",
    "    \"\"\"Overlay a single binary mask on T1c with the given RGB color.\"\"\"\n",
    "    tn = _norm_t1c(t1c)\n",
    "    rgb = np.stack([tn, tn, tn], axis=-1)\n",
    "    for c in range(3):\n",
    "        rgb[..., c] = np.where(mask, (1-alpha)*tn + alpha*color[c], rgb[..., c])\n",
    "    return np.clip(rgb, 0, 1)\n",
    "\n",
    "REGION_CFG = {\n",
    "    'WT': {'fn': get_wt, 'color': [0.2, 0.8, 0.3], 'label': 'Whole Tumor (WT)'},\n",
    "    'TC': {'fn': get_tc, 'color': [0.2, 0.4, 1.0], 'label': 'Tumor Core (TC)'},\n",
    "    'ET': {'fn': get_et, 'color': [1.0, 0.2, 0.2], 'label': 'Enhancing Tumor (ET)'},\n",
    "}\n",
    "\n",
    "def generate_linear_frame(seg_start, seg_end, ti_val):\n",
    "    \"\"\"Linear interpolation baseline: blend soft labels, argmax, morpho cleanup.\"\"\"\n",
    "    ss = seg_to_soft(seg_start)\n",
    "    se = seg_to_soft(seg_end)\n",
    "    blend = (1 - ti_val) * ss + ti_val * se\n",
    "    pred = np.argmax(blend, axis=0).astype(np.int64)\n",
    "    return morpho_cleanup(pred)\n",
    "\n",
    "print('Helpers ready: seg_to_soft, predict_x0, enforce_containment, morpho_cleanup,')\n",
    "print('               overlay_all, overlay_region, REGION_CFG, generate_linear_frame')\n"
   ]
  },
