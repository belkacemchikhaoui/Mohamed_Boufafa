    "# Generate per-patient videos + interactive HTML player\n",
    "import matplotlib;matplotlib.use('Agg');import matplotlib.pyplot as plt\n",
    "import base64\n",
    "from io import BytesIO\n",
    "try:\n",
    "    import imageio\n",
    "    HAS_IMAGEIO=True\n",
    "except:\n",
    "    HAS_IMAGEIO=False\n",
    "\n",
    "vid_dir=OUT/'videos';vid_dir.mkdir(exist_ok=True)\n",
    "html_dir=OUT/'interactive';html_dir.mkdir(exist_ok=True)\n",
    "selected_pids=sorted(patient_pairs.keys())[:10]\n",
    "print(f'Generating for {len(selected_pids)} patients...')\n",
    "\n",
    "def render_frame(img, title, dpi=100):\n",
    "    fig,ax=plt.subplots(1,1,figsize=(5,5),dpi=dpi)\n",
    "    ax.imshow(img,origin='lower',interpolation='bilinear');ax.axis('off')\n",
    "    ax.set_title(title,fontsize=10,fontweight='bold',pad=6)\n",
    "    fig.tight_layout(pad=0.3)\n",
    "    fig.canvas.draw()\n",
    "    buf=np.array(fig.canvas.buffer_rgba())[:,:,:3].copy()\n",
    "    plt.close(fig)\n",
    "    return buf\n",
    "\n",
    "def frame_to_b64(frame):\n",
    "    from PIL import Image\n",
    "    img=Image.fromarray(frame)\n",
    "    bio=BytesIO();img.save(bio,format='PNG');bio.seek(0)\n",
    "    return base64.b64encode(bio.read()).decode('ascii')\n",
    "\n",
    "def build_html_player(pid, frames_b64, labels, out_path):\n",
    "    frames_js='['+','.join([f'\"data:image/png;base64,{b}\"' for b in frames_b64])+']'\n",
    "    labels_js='['+','.join([f'\"{l}\"' for l in labels])+']'\n",
    "    html=f\"\"\"<!DOCTYPE html>\n",
    "<html><head><title>{pid} Tumor Evolution</title>\n",
    "<style>\n",
    "body{{font-family:Arial,sans-serif;background:#111;color:#eee;text-align:center;margin:0;padding:20px}}\n",
    "h1{{color:#4fc3f7;margin-bottom:5px}}\n",
    ".controls{{margin:15px 0;display:flex;align-items:center;justify-content:center;gap:12px}}\n",
    "input[type=range]{{width:500px;accent-color:#4fc3f7}}\n",
    "button{{background:#4fc3f7;color:#111;border:none;padding:8px 18px;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px}}\n",
    "button:hover{{background:#81d4fa}}\n",
    "#label{{font-size:14px;color:#aaa;margin:8px 0}}\n",
    "#counter{{font-size:13px;color:#666}}\n",
    "img{{border:2px solid #333;border-radius:8px}}\n",
    "</style></head><body>\n",
    "<h1>{pid} - Tumor Evolution</h1>\n",
    "<div id='label'></div>\n",
    "<img id='frame' width='500'/>\n",
    "<div class='controls'>\n",
    "<button onclick='prev()'>&#9664; Prev</button>\n",
    "<input type='range' id='slider' min='0' max='{len(frames_b64)-1}' value='0' oninput='show(this.value)'/>\n",
    "<button onclick='next()'>Next &#9654;</button>\n",
    "<button id='playBtn' onclick='togglePlay()'>&#9654; Play</button>\n",
    "</div>\n",
    "<div id='counter'></div>\n",
    "<script>\n",
    "var frames={frames_js};\n",
    "var labels={labels_js};\n",
    "var idx=0,playing=false,timer=null;\n",
    "function show(i){{idx=parseInt(i);document.getElementById('frame').src=frames[idx];document.getElementById('slider').value=idx;document.getElementById('label').innerText=labels[idx];document.getElementById('counter').innerText='Frame '+(idx+1)+'/'+frames.length;}}\n",
    "function prev(){{if(idx>0)show(idx-1);}}\n",
    "function next(){{if(idx<frames.length-1)show(idx+1);}}\n",
    "function togglePlay(){{playing=!playing;document.getElementById('playBtn').innerText=playing?'|| Pause':'\\u25B6 Play';if(playing)timer=setInterval(function(){{if(idx<frames.length-1)show(idx+1);else{{playing=false;document.getElementById('playBtn').innerText='\\u25B6 Play';clearInterval(timer);}}}},500);else clearInterval(timer);}}\n",
    "show(0);\n",
    "document.addEventListener('keydown',function(e){{if(e.key=='ArrowLeft')prev();if(e.key=='ArrowRight')next();if(e.key==' ')togglePlay();}});\n",
    "</script></body></html>\"\"\"\n",
    "    with open(out_path,'w') as f:f.write(html)\n",
    "\n",
    "# === FIX: temporal majority-vote smoothing (removes frame-to-frame flicker) ===\n",
    "from scipy import stats as sp_stats\n",
    "\n",
    "def temporal_smooth_segs(seg_list, window=3):\n",
    "    \"\"\"Majority-vote across a sliding temporal window to kill per-frame pixel flicker.\n",
    "    Each pixel keeps the class that wins the majority vote over [t-1, t, t+1].\n",
    "    \"\"\"\n",
    "    if len(seg_list) <= 2:\n",
    "        return seg_list\n",
    "    import numpy as _np\n",
    "    arr = _np.stack([s[0] for s in seg_list], axis=0)  # (T, H, W)\n",
    "    out = arr.copy()\n",
    "    n_cls = int(arr.max()) + 1\n",
    "    for t in range(len(arr)):\n",
    "        lo = max(0, t - window // 2)\n",
    "        hi = min(len(arr), t + window // 2 + 1)\n",
    "        win = arr[lo:hi]  # (k, H, W)\n",
    "        votes = _np.zeros((n_cls,) + arr.shape[1:], dtype=_np.int32)\n",
    "        for c in range(n_cls):\n",
    "            votes[c] = (win == c).sum(axis=0)\n",
    "        out[t] = _np.argmax(votes, axis=0).astype(arr.dtype)\n",
    "    return [(out[i], seg_list[i][1]) for i in range(len(seg_list))]\n",
    "\n",
    "for pi,pid in enumerate(selected_pids):\n",
    "    pairs=patient_pairs[pid]\n",
    "    t1c=pairs[0]['t1c_start']\n",
    "    \n",
    "    # Generate all segmentation predictions (both DDPM and Linear)\n",
    "    all_segs_ddpm = []\n",
    "    all_segs_linear = []\n",
    "    import hashlib\n",
    "    seed = int(hashlib.md5(pid.encode()).hexdigest(), 16) % (2**32)\n",
    "    g = torch.Generator().manual_seed(seed)\n",
    "    ss_sample = pairs[0]['seg_start']\n",
    "    ss_soft = torch.from_numpy(seg_to_soft(ss_sample)).unsqueeze(0).to(device)\n",
    "    noise = torch.randn(ss_soft.shape, generator=g).to(device)\n",
    "    for gap_idx,pair in enumerate(pairs):\n",
    "        ss=pair['seg_start'];se=pair['seg_end']\n",
    "        for fi,tv in enumerate(np.linspace(0,1,N_INTERP)):\n",
    "            if tv==1.0 and gap_idx<len(pairs)-1:continue\n",
    "            if tv==0:\n",
    "                seg_d = seg_l = morpho_cleanup(ss)\n",
    "            elif tv==1.0:\n",
    "                seg_d = seg_l = morpho_cleanup(se)\n",
    "            else:\n",
    "                seg_d = generate_frame(model,ss,se,tv,noise=noise)\n",
    "                seg_l = generate_linear_frame(ss,se,tv)\n",
    "            lbl=f'Scan {gap_idx+1}->{gap_idx+2} | t={tv:.2f}'\n",
    "            all_segs_ddpm.append((seg_d,lbl))\n",
    "            all_segs_linear.append((seg_l,lbl))\n",
    "    # === FIX: apply temporal smoothing before rendering ===\n",
    "    all_segs_ddpm = temporal_smooth_segs(all_segs_ddpm, window=3)\n",
    "    \n",
    "    \n",
    "    # Build 4 video types\n",
    "    for vid_type in ['ALL','WT','TC','ET']:\n",
    "        # 1. DDPM\n",
    "        frames=[];frames_b64=[];labels=[]\n",
    "        for seg,lbl in all_segs_ddpm:\n",
    "            if vid_type=='ALL':\n",
    "                img=overlay_all(seg,t1c)\n",
    "                wt_ml=get_wt(seg).sum()*PX_TO_ML\n",
    "                tc_ml=get_tc(seg).sum()*PX_TO_ML\n",
    "                et_ml=get_et(seg).sum()*PX_TO_ML\n",
    "                title=f'{pid} (DDPM)\\n{lbl}\\nWT={wt_ml:.1f}mL  TC={tc_ml:.1f}mL  ET={et_ml:.1f}mL'\n",
    "            else:\n",
    "                cfg=REGION_CFG[vid_type]\n",
    "                mask=cfg['fn'](seg)\n",
    "                img=overlay_region(mask,t1c,cfg['color'])\n",
    "                vol_ml=mask.sum()*PX_TO_ML\n",
    "                title=f'{pid} [{cfg[\"label\"]}] (DDPM)\\n{lbl}\\nVolume: {vol_ml:.2f} mL'\n",
    "            buf=render_frame(img,title)\n",
    "            frames.append(buf)\n",
    "            frames_b64.append(frame_to_b64(buf))\n",
    "            labels.append(title.replace('\\n',' | '))\n",
    "        \n",
    "        fpath=str(vid_dir/f'{pid}_{vid_type}.mp4')\n",
    "        if HAS_IMAGEIO:imageio.mimsave(fpath,frames,fps=FPS, macro_block_size=1)\n",
    "        hpath=str(html_dir/f'{pid}_{vid_type}.html')\n",
    "        build_html_player(pid+' '+vid_type+' (DDPM)',frames_b64,labels,hpath)\n",
    "        \n",
    "        # 2. Linear\n",
    "        frames_lin=[];frames_b64_lin=[];labels_lin=[]\n",
    "        for seg,lbl in all_segs_linear:\n",
    "            if vid_type=='ALL':\n",
    "                img=overlay_all(seg,t1c)\n",
    "                wt_ml=get_wt(seg).sum()*PX_TO_ML\n",
    "                tc_ml=get_tc(seg).sum()*PX_TO_ML\n",
    "                et_ml=get_et(seg).sum()*PX_TO_ML\n",
    "                title=f'{pid} (Linear)\\n{lbl}\\nWT={wt_ml:.1f}mL  TC={tc_ml:.1f}mL  ET={et_ml:.1f}mL'\n",
    "            else:\n",
    "                cfg=REGION_CFG[vid_type]\n",
    "                mask=cfg['fn'](seg)\n",
    "                img=overlay_region(mask,t1c,cfg['color'])\n",
    "                vol_ml=mask.sum()*PX_TO_ML\n",
    "                title=f'{pid} [{cfg[\"label\"]}] (Linear)\\n{lbl}\\nVolume: {vol_ml:.2f} mL'\n",
    "            buf=render_frame(img,title)\n",
    "            frames_lin.append(buf)\n",
    "            frames_b64_lin.append(frame_to_b64(buf))\n",
    "            labels_lin.append(title.replace('\\n',' | '))\n",
    "        \n",
    "        fpath_lin=str(vid_dir/f'{pid}_{vid_type}_linear.mp4')\n",
    "        if HAS_IMAGEIO:imageio.mimsave(fpath_lin,frames_lin,fps=FPS, macro_block_size=1)\n",
    "        hpath_lin=str(html_dir/f'{pid}_{vid_type}_linear.html')\n",
    "        build_html_player(pid+' '+vid_type+' (Linear)',frames_b64_lin,labels_lin,hpath_lin)\n",
    "    \n",
    "    print(f'  [{pi+1}/{len(selected_pids)}] {pid}: {len(all_segs_ddpm)} frames x 4 (mp4+html)')\n",
    "\n",
    "print(f'Done! Videos: {vid_dir} | Interactive: {html_dir}')\n",
    ""
   ]
  },
