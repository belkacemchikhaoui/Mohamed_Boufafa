    "import os,time,math,gc,warnings\n",
    "import numpy as np\n",
    "import torch,torch.nn as nn,torch.nn.functional as F\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "warnings.filterwarnings('ignore')\n",
    "device=torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {device}')\n",
    "OUT=Path('/kaggle/working/video_gen');OUT.mkdir(parents=True,exist_ok=True)\n",
    "NOISE_T=5\n",
    "N_INTERP=15\n",
    "FPS=3  # slower playback for better viewing\n",
    "# BraTS: 1mm iso, original ~240x240 resized to 128x128, 1mm slice thickness\n",
    "# pixel_area = (240/128)^2 * 1mm = 3.516 mm^3 per pixel\n",
    "# 1 mL = 1000 mm^3\n",
    "PX_TO_ML = (240/128)**2 * 1.0 / 1000.0  # 0.003516 mL per pixel\n",
    "print(f'Config: noise_t={NOISE_T}, frames/gap={N_INTERP}, fps={FPS}, px_to_mL={PX_TO_ML:.4f}')\n"
   ]
  },
