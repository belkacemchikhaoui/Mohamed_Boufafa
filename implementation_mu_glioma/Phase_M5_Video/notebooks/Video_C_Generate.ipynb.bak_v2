   "source": [
    "@torch.no_grad()\n",
    "def generate_frame(model, seg_start, seg_end, ti_val, noise=None):\n",
    "    ss=torch.from_numpy(seg_to_soft(seg_start)).unsqueeze(0).to(device)\n",
    "    se=torch.from_numpy(seg_to_soft(seg_end)).unsqueeze(0).to(device)\n",
    "    cond=torch.cat([ss,se],1)\n",
    "    blend=(1-ti_val)*ss+ti_val*se\n",
    "    t=torch.full((1,),NOISE_T,device=device,dtype=torch.long)\n",
    "    if noise is None:\n",
    "        noise=torch.randn_like(blend)\n",
    "    xt=sac[t][:,None,None,None]*blend+s1mac[t][:,None,None,None]*noise\n",
    "    ti=torch.full((1,1),ti_val,device=device)\n",
    "    np_=model(xt,t,cond,ti)\n",
    "    pred=enforce_containment(predict_x0(xt,t,np_).argmax(1)[0]).cpu().numpy()\n",
    "    return morpho_cleanup(pred)"
   ]
  },
