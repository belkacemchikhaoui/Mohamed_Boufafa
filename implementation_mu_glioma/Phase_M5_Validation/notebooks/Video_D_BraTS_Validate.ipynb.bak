   "source": [
    "# Noise schedule\n",
    "T=50\n",
    "def cosine_betas(T,s=0.008):\n",
    "    t=torch.linspace(0,T,T+1)\n",
    "    ac=torch.cos(((t/T)+s)/(1+s)*math.pi*0.5)**2\n",
    "    ac=ac/ac[0];b=1-(ac[1:]/ac[:-1])\n",
    "    return torch.clip(b,0.0001,0.9999)\n",
    "betas=cosine_betas(T).to(device)\n",
    "alphas=1-betas;ac=torch.cumprod(alphas,0)\n",
    "sac=torch.sqrt(ac);s1mac=torch.sqrt(1-ac)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "44685956",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-05-14T02:26:29.618934Z",
     "iopub.status.busy": "2026-05-14T02:26:29.618603Z",
     "iopub.status.idle": "2026-05-14T02:26:31.157982Z",
     "shell.execute_reply": "2026-05-14T02:26:31.157035Z"
    },
    "papermill": {
     "duration": 1.544029,
     "end_time": "2026-05-14T02:26:31.159654+00:00",
     "exception": false,
     "start_time": "2026-05-14T02:26:29.615625+00:00",
