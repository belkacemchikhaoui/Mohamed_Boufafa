   "source": [
    "# ============================================================\n",
    "# HELPER FUNCTIONS: seg_to_soft, morpho_cleanup, predict_x0,\n",
    "# enforce_containment, overlay_all, dice_sc, generate_linear_frame\n",
    "# ============================================================\n",
    "from scipy import ndimage\n",
    "\n",
    "def seg_to_soft(seg, C=5):\n",
    "    oh = np.zeros((C, seg.shape[0], seg.shape[1]), dtype=np.float32)\n",
    "    for c in range(C):\n",
    "        oh[c] = (seg == c).astype(np.float32)\n",
    "    return oh * 1.9 - 0.95\n",
    "\n",
    "def predict_x0(xt, t, noise_pred):\n",
    "    x0 = (xt - s1mac[t][:,None,None,None]*noise_pred) / sac[t][:,None,None,None].clamp(min=1e-4)\n",
    "    return x0.clamp(-2, 2)\n",
    "\n",
    "def enforce_containment(seg):\n",
    "    out = seg.clone()\n",
    "    tc = (out == 1) | (out == 4)\n",
    "    et = out == 4\n",
    "    out[et & ~tc] = 1\n",
    "    tc = (out == 1) | (out == 4)\n",
    "    out[tc & ~(out > 0)] = 2\n",
    "    return out\n",
    "\n",
    "def morpho_cleanup(seg, min_size=30):\n",
    "    out = seg.copy().astype(np.int64)\n",
    "    for label in [1, 2, 4]:\n",
    "        mask = (seg == label)\n",
    "        if not mask.any(): continue\n",
    "        labeled, n = ndimage.label(mask)\n",
    "        sizes = ndimage.sum(mask, labeled, range(1, n + 1))\n",
    "        for ci in range(n):\n",
    "            if sizes[ci] < min_size:\n",
    "                out[labeled == (ci + 1)] = 0\n",
    "    return out\n",
    "\n",
    "def dice_sc(p, g):\n",
    "    r = {}\n",
    "    for n, pm, gm in [('WT', p>0, g>0),\n",
    "                      ('TC', (p==1)|(p==4), (g==1)|(g==4)),\n",
    "                      ('ET', p==4, g==4)]:\n",
    "        r[n] = (2*(pm&gm).sum().float() / (pm.sum().float()+gm.sum().float()+1e-8)).item()\n",
    "    return r\n",
    "\n",
    "def get_wt(seg): return seg > 0\n",
    "def get_tc(seg): return (seg == 1) | (seg == 4)\n",
    "def get_et(seg): return seg == 4\n",
    "\n",
    "def _norm_t1c(t1c):\n",
    "    t = t1c - t1c.min(); mx = t.max()\n",
    "    return t / mx if mx > 0 else t\n",
    "\n",
    "def overlay_all(seg, t1c, alpha=0.55):\n",
    "    tn = _norm_t1c(t1c)\n",
    "    rgb = np.stack([tn, tn, tn], axis=-1)\n",
    "    for label, color in {2:[0.2,0.8,0.3], 1:[0.2,0.4,1.0], 4:[1.0,0.2,0.2]}.items():\n",
    "        mask = (seg == label)\n",
    "        if mask.any():\n",
    "            for c in range(3):\n",
    "                rgb[...,c] = np.where(mask, (1-alpha)*tn + alpha*color[c], rgb[...,c])\n",
    "    return np.clip(rgb, 0, 1)\n",
    "\n",
    "def generate_linear_frame(seg_start, seg_end, ti_val):\n",
    "    ss = seg_to_soft(seg_start); se = seg_to_soft(seg_end)\n",
    "    pred = np.argmax((1-ti_val)*ss + ti_val*se, axis=0).astype(np.int64)\n",
    "    return morpho_cleanup(pred)\n",
    "\n",
    "print('Helpers ready: seg_to_soft, morpho_cleanup, predict_x0, enforce_containment,')\n",
    "print('               dice_sc, overlay_all, generate_linear_frame')\n"
   ]
  },
