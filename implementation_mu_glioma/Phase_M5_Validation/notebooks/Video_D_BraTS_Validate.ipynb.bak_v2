   "source": [
    "@torch.no_grad()\n",
    "def generate_frame(model, seg_start, seg_end, ti_val, noise=None):\n",
    "    ss=torch.from_numpy(seg_to_soft(seg_start)).unsqueeze(0).to(device)\n",
    "    se=torch.from_numpy(seg_to_soft(seg_end)).unsqueeze(0).to(device)\n",
    "    cond=torch.cat([ss,se],1); blend=(1-ti_val)*ss+ti_val*se\n",
    "    t=torch.full((1,),NOISE_T,device=device,dtype=torch.long)\n",
    "    if noise is None:\n",
    "        noise = torch.randn_like(blend)\n",
    "    xt=sac[t][:,None,None,None]*blend+s1mac[t][:,None,None,None]*noise\n",
    "    ti=torch.full((1,1),ti_val,device=device)\n",
    "    return morpho_cleanup(enforce_containment(predict_x0(xt,t,model(xt,t,cond,ti)).argmax(1)[0]).cpu().numpy())\n",
    "\n",
    "def temporal_smooth_segs(seg_list, window=3):\n",
    "    \"\"\"Majority-vote temporal smoothing to remove frame-to-frame flickering.\"\"\"\n",
    "    if len(seg_list) <= 2: return seg_list\n",
    "    arr = np.stack([s[0] for s in seg_list], axis=0)\n",
    "    out = arr.copy(); n_cls = int(arr.max()) + 1\n",
    "    for t in range(len(arr)):\n",
    "        lo = max(0, t - window//2); hi = min(len(arr), t + window//2 + 1)\n",
    "        win = arr[lo:hi]\n",
    "        votes = np.zeros((n_cls,) + arr.shape[1:], dtype=np.int32)\n",
    "        for c in range(n_cls): votes[c] = (win == c).sum(axis=0)\n",
    "        out[t] = np.argmax(votes, axis=0).astype(arr.dtype)\n",
    "    return [(out[i], seg_list[i][1]) for i in range(len(seg_list))]\n",
    "\n",
    "print('generate_frame (fixed-seed noise) + temporal_smooth_segs ready')"
   ]
  },
