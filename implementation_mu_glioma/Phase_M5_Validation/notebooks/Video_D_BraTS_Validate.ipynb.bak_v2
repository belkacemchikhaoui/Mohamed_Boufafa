    "import hashlib\n",
    "\n",
    "for pi, pid in enumerate(all_pids):\n",
    "    pairs = brats_pairs[pid][:4]  # max 4 gaps\n",
    "    t1c = pairs[0]['t1c_start']\n",
    "\n",
    "    # Fixed per-patient noise seed for temporal consistency\n",
    "    seed = int(hashlib.md5(pid.encode()).hexdigest(), 16) % (2**32)\n",
    "    g = torch.Generator().manual_seed(seed)\n",
    "    ss0 = torch.from_numpy(seg_to_soft(pairs[0]['seg_start'])).unsqueeze(0).to(device)\n",
    "    noise = torch.randn(ss0.shape, generator=g).to(device)\n",
    "\n",
    "    # Generate all segmentation frames\n",
    "    all_segs = []\n",
    "    for gi, pair in enumerate(pairs):\n",
    "        ss = pair['seg_start']; se = pair['seg_end']\n",
    "        for fi, tv in enumerate(np.linspace(0, 1, N_INTERP)):\n",
    "            if tv == 1.0 and gi < len(pairs) - 1: continue\n",
    "            if tv == 0: seg = morpho_cleanup(ss)\n",
    "            elif tv == 1.0: seg = morpho_cleanup(se)\n",
    "            else: seg = generate_frame(model, ss, se, tv, noise=noise)\n",
    "            all_segs.append((seg, f'Scan {gi+1}->{gi+2} | t={tv:.2f}'))\n",
    "\n",
    "    # Temporal smoothing to remove per-frame pixel flicker\n",
    "    all_segs = temporal_smooth_segs(all_segs, window=3)\n"
   ]
  },
